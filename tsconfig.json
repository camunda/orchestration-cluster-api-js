{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "outDir": "dist",
    // Source-time resolution of the #platform subpath import (see package.json "imports").
    "paths": { "#platform": ["./src/runtime/platform/node.ts"] }
  },
  "include": ["src", "scripts"],
  "exclude": ["dist", "node_modules"]
}
